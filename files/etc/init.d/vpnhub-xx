#!/bin/sh /etc/rc.common
# vpnhub: one xray per "this site through that server" rule whose link needs xray
USE_PROCD=1
start_service() {
	for f in /var/run/vpnhub/xsx[1-5].json; do
		[ -f "$f" ] || continue
		n=${f##*/}; n=${n%.json}
		procd_open_instance "$n"
		procd_set_param command /usr/bin/xray run -c "$f"
		procd_set_param respawn 60 10 5
		procd_set_param stderr 1
		procd_close_instance
	done
}
