#!/bin/sh /etc/rc.common
# vpnhub: runs sing-box for the V2Ray page (started and stopped by /usr/bin/vpnhub, never enabled at boot)
USE_PROCD=1
start_service() {
	[ -f /var/run/vpnhub/sing-box.json ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/sing-box run -c /var/run/vpnhub/sing-box.json -D /var/run/vpnhub
	procd_set_param respawn 60 10 5
	procd_set_param stderr 1
	procd_close_instance
}
