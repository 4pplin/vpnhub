#!/bin/sh /etc/rc.common
# vpnhub: one sing-box per "this site through that server" rule (started and stopped by /usr/bin/vpnhub)
USE_PROCD=1
start_service() {
	for f in /var/run/vpnhub/sx[1-5].json; do
		[ -f "$f" ] || continue
		n=${f##*/}; n=${n%.json}
		mkdir -p /var/run/vpnhub/$n
		procd_open_instance "$n"
		procd_set_param command /usr/bin/sing-box run -c "$f" -D /var/run/vpnhub/$n
		procd_set_param respawn 60 10 5
		procd_set_param stderr 1
		procd_close_instance
	done
}
