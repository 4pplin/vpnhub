#!/bin/sh /etc/rc.common
# vpnhub: optional status light (only runs when switched on in the vpnhub settings page)
START=99
USE_PROCD=1
start_service() {
	grep -qE '^LED_MODE=(rgb|single)' /etc/vpnhub/led 2>/dev/null || return 0
	procd_open_instance
	procd_set_param command /usr/lib/vpnhub/led.sh run
	procd_set_param respawn
	procd_close_instance
}
service_stopped() { /usr/lib/vpnhub/led.sh restore; }
