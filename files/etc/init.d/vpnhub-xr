#!/bin/sh /etc/rc.common
# vpnhub: runs xray for V2Ray links that sing-box cannot read (VLESS encryption); sing-box forwards its tun traffic to it
USE_PROCD=1
start_service() {
	[ -f /var/run/vpnhub/xray.json ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/xray run -c /var/run/vpnhub/xray.json
	procd_set_param respawn 60 10 5
	procd_set_param stderr 1
	procd_close_instance
}
